<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= metaDescription %>" />
  <link rel="stylesheet" href="/css/app.css" />
  <link rel="stylesheet" href="/css/player.css" />
</head>
<body>
  <%- include('./partials/navbar') %>

  <main class="container page-pad">
    <h1><%= movie.title %></h1>

    <div
      class="watch-shell"
      data-watch-page
      data-media-type="movie"
      data-tmdb-id="<%= movie.id %>"
      data-api-url="/api/embed/movie/<%= movie.id %>"
      data-selected-provider="<%= selectedProvider %>"
      data-csrf="<%= csrfToken %>">
      <div class="player-wrapper">
        <div class="player-loading" data-player-loading>Loading player...</div>
        <iframe
          data-player-iframe
          src="<%= embedUrl %>"
          title="Video player for <%= movie.title %>"
          allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
          allowfullscreen
          referrerpolicy="origin"></iframe>
      </div>

      <%- include('./partials/provider-selector', { providers, selectedProvider }) %>
      <%- include('./partials/player-options') %>
    </div>

    <section class="surface-card top-gap">
      <h2>Movie Information</h2>
      <p><%= movie.overview %></p>
      <% if (savedProgress) { %>
        <p class="muted">Resume saved at <%= Math.floor(savedProgress.progress_seconds) %>s.</p>
      <% } %>
    </section>
  </main>

  <script>
    window.LIGHTSOUT_PROVIDER_ORIGINS = <%- JSON.stringify(providers.map(p => ({ key: p.key, origin: p.origin }))) %>;
  </script>
  <script src="/js/player.js"></script>
  <script src="/js/watch-progress.js"></script>
</body>
</html>
