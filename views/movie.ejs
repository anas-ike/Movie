tainer detail-section"><div class="detail-facts"><div><span>Release</span><strong><%= movie.releaseDate || 'Not available' %></strong></div><div><span>Language</span><strong><%= movie.originalLanguage || 'Not available' %></strong></div><div><span>Production</span><strong><%= movie.productionCompanies?.[0]?.name || 'Not available' %></strong></div></div><% if (movie.credits?.cast?.length) { %><h2>Cast</h2><div class="cast-row"><% movie.credits.cast.forEach((person) => { %><div class="cast-card"><img src="<%= person.profileUrl %>" alt="<%= person.name %>" loading="lazy" decoding="async"><strong><%= person.name %></strong><span><%= person.character %></span></div><% }) %></div><% } %></section><% if (movie.recommendations?.length) { %><%- include('./partials/media-row', { title: 'More like this', items: movie.recommendations }) %><% } %></main><%- include('./partials/footer') %><script src="/js/favorites.js"></script><script src="/js/app.js"></script></body></html>
