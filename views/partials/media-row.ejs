<section class="media-row-section">
  <div class="container">
    <div class="section-head">
      <h2><%= title %></h2>
    </div>
    <div class="media-row">
      <% items.forEach((item) => { %>
        <% if (item.mediaType === 'movie') { %>
          <%- include('./movie-card', { item }) %>
        <% } else { %>
          <%- include('./show-card', { item }) %>
        <% } %>
      <% }) %>
    </div>
  </div>
</section>
