<section class="server-panel" aria-label="Playback servers">
  <span class="server-label">Servers</span>
  <div class="server-selector" data-server-selector>
    <% servers.forEach((server) => { %>
      <button type="button" class="server-btn <%= selectedServer === server.id ? 'active' : '' %>" data-server="<%= server.id %>" aria-pressed="<%= selectedServer === server.id %>"><%= server.label %></button>
    <% }) %>
  </div>
</section>
