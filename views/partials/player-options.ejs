<div class="player-options">
  <div class="option-grid">
    <label>
      <span>Subtitle</span>
      <select data-player-option="subtitle">
        <option value="english">English</option>
      </select>
    </label>

    <label>
      <span>Autoplay</span>
      <select data-player-option="autoplay">
        <option value="false">Off</option>
        <option value="true">On</option>
      </select>
    </label>
  </div>
</div>
