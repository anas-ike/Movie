<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= metaDescription %>" />
  <link rel="stylesheet" href="/css/app.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
  <link rel="stylesheet" href="/css/player.css" />
  <link rel="stylesheet" href="/css/components.css" />
</head>
<body>
  <%- include('./partials/navbar') %>

  <main class="container page-pad">
    <h1><%= show.title %> - Season <%= season.seasonNumber %></h1>
    <div class="episode-grid">
      <% season.episodes.forEach((ep) => { %>
        <a class="episode-card" href="/watch/tv/<%= show.id %>/<%= season.seasonNumber %>/<%= ep.episodeNumber %>">
          <img src="<%= ep.stillUrl %>" alt="<%= ep.name %> still" loading="lazy" />
          <div class="episode-body">
            <h3>S<%= String(season.seasonNumber).padStart(2, '0') %>E<%= String(ep.episodeNumber).padStart(2, '0') %> - <%= ep.name %></h3>
            <p><%= ep.overview || 'No overview available.' %></p>
          </div>
        </a>
      <% }) %>
    </div>
  </main>

  <%- include('./partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>
